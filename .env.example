# PostgreSQL (use a URL-safe random password for DATABASE_URL interpolation)
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=
POSTGRES_DB=visionguard

# Required backend signing key: generate a random value of at least 32 bytes.
JWT_SECRET=

# Browser origins permitted to call the API; local Vite defaults are shown.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_VIDEO_SIZE_BYTES=524288000
OLLAMA_URL=http://host.docker.internal:11434/api/generate
PERSON_MODEL=yolov8n.pt
